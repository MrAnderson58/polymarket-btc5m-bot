# Polymarket CLOB (read-only endpoints work without credentials)
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Gamma API for market discovery
GAMMA_API=https://gamma-api.polymarket.com

# BTC price source (Binance public API)
BINANCE_API=https://api.binance.com
BTC_SYMBOL=BTCUSDT
# In-memory spot price cache TTL (seconds); should be >= POLL_INTERVAL_SEC for HIT between cycles
BTC_PRICE_CACHE_TTL_SEC=2.0

# Strategy
POLL_INTERVAL_SEC=2
STRATEGY_WINDOW_SEC=45
STRIKE_THRESHOLD_USD=150
TRADE_SIZE_USDC=10.0
EARLY_REVERSION_WINDOW_SEC=30
EARLY_REVERSION_POSITION_SIZE_USDC=2.10
# Comma-separated Early Reversion strategies: YES_A, YES_B, YES_C, NO_A, NO_B, NO_C
# Live v2 uses this list; default is NO_C only (YES_C runs in shadow mode).
ENABLED_STRATEGIES=NO_C
# Enable/disable strategy versions (code remains; only active versions run in main loop)
ENABLE_V1=false
ENABLE_V2=true
ENABLE_V25=false
ENABLE_V3=false
# Late-window signal + virtual trades (strategy_version=late_window); off for ER-only live tests
ENABLE_LATE_WINDOW=false
# Exit mode: fixed = legacy percent trailing; trailing = dollar activation/offset
EXIT_MODE=trailing
ENABLE_TRAILING_STOP=true
TRAILING_ACTIVATION_PROFIT=0.03
TRAILING_OFFSET=0.01
# Early Reversion v2 (optional override; falls back to ENABLED_STRATEGIES)
# ENABLED_STRATEGIES_V2=NO_C,YES_B
ER_V2_ENTRY_WINDOW_SEC=30
# Adjust ER entry ask threshold: effective = base + offset (e.g. 0.40 + (-0.01) = 0.39)
ER_ENTRY_PRICE_OFFSET=0
ER_V2_GRACE_PERIOD_SEC=30
ER_V2_TRAILING_STOP_PCT=5
ER_V2_STOP_LOSS_PCT=-10
ER_V2_TIME_STOP_SEC=90
# Early Reversion v2.5 (optional override; falls back to ENABLED_STRATEGIES)
# ENABLED_STRATEGIES_V25=NO_C,YES_B
ER_V25_GRACE_PERIOD_SEC=15
# Early Reversion v3 (optional override; falls back to ENABLED_STRATEGIES)
# ENABLED_STRATEGIES_V3=NO_C,YES_B
ER_V3_POLL_INTERVAL_SEC=0.5
ER_V3_ENTRY_WINDOW_SEC=30
ER_V3_TRAILING_GRACE_SEC=30
ER_V3_TRAILING_STOP_PCT=5
ER_V3_STOP_LOSS_PCT=-10
ER_V3_TIME_STOP_SEC=90

# ER rejection summary log interval (seconds)
ER_SUMMARY_INTERVAL_SEC=300

# V4 Shadow — virtual-only research strategy (no CLOB orders)
ENABLE_V4_SHADOW=false
# YES_C Shadow — virtual Early Reversion v2 for YES_C (no CLOB orders)
ENABLE_YES_C_SHADOW=true
# NO_C Filter Shadow — log WOULD_BLOCK on BTC-up moves; never blocks live entries
ENABLE_NO_C_FILTER_SHADOW=true
V4_POLL_INTERVAL_SEC=1
V4_OBSERVE_SECONDS=120
V4_MIN_PROBABILITY=0.70
V4_MIN_SCORE=8
V4_PULLBACK=0.02

# Futures research — PostgreSQL source (production Telegram collector, read-only)
# FUTURES_SOURCE_DATABASE_URL=postgresql:///trading_ai
# FUTURES_SOURCE_BACKEND=postgres
# FUTURES_REQUIRE_POSTGRES=true
# FUTURES_RESEARCH_DATABASE_PATH=data/trades.db

# Futures Intelligence Agent — PostgreSQL trading_ai (additive tables only)
# FUTURES_AGENT_DATABASE_URL=postgresql:///trading_ai
# FUTURES_AGENT_SQLITE_PATH=data/futures_agent.db
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_AGENT_CHAT_ID=
# TELEGRAM_AGENT_ALLOWED_CHAT_IDS=517492533

# SQLite database path
DATABASE_PATH=data/trades.db

# Trading mode: paper | dry_run | live
TRADING_MODE=paper
LIVE_EXIT_ENABLED=false
LIVE_ENABLED=true
LIVE_MODE=micro
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_USDC=10.0
PORTFOLIO_DAILY_LOSS_LIMIT_USDC=5.0
PORTFOLIO_STARTING_BALANCE_USDC=100.0
# Micro live caps position size at $1 (see bot/portfolio/sizing.py)
EARLY_REVERSION_POSITION_SIZE_USDC=1.0

# Optional — required for TRADING_MODE=live
# POLY_PRIVATE_KEY=
# POLY_PROXY_WALLET=
# POLY_SIGNATURE_TYPE=1

# Check wallet / balance / allowance / API / order signing:
# python -m bot.clob_healthcheck
