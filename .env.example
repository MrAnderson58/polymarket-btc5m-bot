# Polymarket CLOB (read-only endpoints work without credentials)
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Gamma API for market discovery
GAMMA_API=https://gamma-api.polymarket.com

# BTC price source (Binance public API)
BINANCE_API=https://api.binance.com
BTC_SYMBOL=BTCUSDT

# Strategy
POLL_INTERVAL_SEC=2
STRATEGY_WINDOW_SEC=45
STRIKE_THRESHOLD_USD=150
TRADE_SIZE_USDC=10.0
EARLY_REVERSION_WINDOW_SEC=30
EARLY_REVERSION_POSITION_SIZE_USDC=1.0
# Comma-separated Early Reversion strategies: YES_A, YES_B, YES_C, NO_A, NO_B, NO_C
# Applies to v1; also used as default for v2 / v2.5 / v3 unless overridden below.
ENABLED_STRATEGIES=YES_B,YES_C,NO_C
# Early Reversion v2 (optional override; falls back to ENABLED_STRATEGIES)
# ENABLED_STRATEGIES_V2=NO_C,YES_B
ER_V2_ENTRY_WINDOW_SEC=30
ER_V2_GRACE_PERIOD_SEC=30
ER_V2_TRAILING_STOP_PCT=5
ER_V2_STOP_LOSS_PCT=-10
ER_V2_TIME_STOP_SEC=90
# Early Reversion v2.5 (optional override; falls back to ENABLED_STRATEGIES)
# ENABLED_STRATEGIES_V25=NO_C,YES_B
ER_V25_GRACE_PERIOD_SEC=15
# Early Reversion v3 (optional override; falls back to ENABLED_STRATEGIES)
# ENABLED_STRATEGIES_V3=NO_C,YES_B
ER_V3_POLL_INTERVAL_SEC=0.5
ER_V3_ENTRY_WINDOW_SEC=30
ER_V3_TRAILING_GRACE_SEC=30
ER_V3_TRAILING_STOP_PCT=5
ER_V3_STOP_LOSS_PCT=-10
ER_V3_TIME_STOP_SEC=90

# SQLite database path
DATABASE_PATH=data/trades.db

# Trading mode: paper | dry_run | live
TRADING_MODE=paper
LIVE_EXIT_ENABLED=false
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_USDC=10.0

# Optional — required for TRADING_MODE=live
# POLY_PRIVATE_KEY=
# POLY_PROXY_WALLET=
# POLY_SIGNATURE_TYPE=1
